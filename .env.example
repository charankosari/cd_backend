# Copy this file to ".env" (same folder) and fill in real values.
# .env is git-ignored, so secrets never get committed. Every line is optional:
# anything you leave out falls back to the default in application.yml.

# ---- Server
PORT=8081

# ---- Database (default: in-memory H2, wiped on restart)
# PostgreSQL example:
# DB_URL=jdbc:postgresql://localhost:5432/feedback
# DB_USERNAME=feedback_app
# DB_PASSWORD=change-me
# DB_DDL_AUTO=update
# SEED_ENABLED=false
# H2_CONSOLE=false

# ---- Auth
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_TTL_HOURS=168
# Fixed OTP while there is no SMS provider. Leave empty for random codes.
OTP_FIXED_CODE=123456

# ---- Files
UPLOAD_DIR=uploads
